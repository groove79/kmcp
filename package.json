{
  "name": "kmcp",
  "private": true,
  "version": "0.0.0",
  "description": "K-MCP — Model Context Protocol servers for Korean platforms (Naver Commerce, Cafe24, public data, and more)",
  "license": "MIT",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "pnpm -r build",
    "test": "pnpm -r test",
    "typecheck": "pnpm -r typecheck",
    "clean": "pnpm -r exec rm -rf dist"
  },
  "devDependencies": {
    "typescript": "^5.6.3"
  },
  "pnpm": {
    "supportedArchitectures": {
      "os": [
        "current",
        "darwin"
      ],
      "cpu": [
        "current",
        "arm64"
      ]
    }
  }
}
