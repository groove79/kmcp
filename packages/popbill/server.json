{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-10-17/server.schema.json",
  "name": "io.github.groove79/mcp-popbill",
  "description": "Popbill MCP: Korean e-tax invoices (issue/cancel/search, Hometax sync) + KakaoTalk 알림톡. 팝빌 MCP.",
  "title": "Popbill (세금계산서·알림톡)",
  "version": "0.2.0",
  "websiteUrl": "https://appmonster.co.kr",
  "repository": {
    "url": "https://github.com/groove79/kmcp",
    "source": "github",
    "subfolder": "packages/popbill"
  },
  "packages": [
    {
      "registryType": "npm",
      "registryBaseUrl": "https://registry.npmjs.org",
      "identifier": "@appmonster/mcp-popbill",
      "version": "0.2.0",
      "transport": {
        "type": "stdio"
      },
      "environmentVariables": [
        {
          "name": "POPBILL_LINK_ID",
          "description": "Popbill API link id (developers.popbill.com)",
          "isRequired": true,
          "isSecret": false
        },
        {
          "name": "POPBILL_SECRET_KEY",
          "description": "Popbill API secret key",
          "isRequired": true,
          "isSecret": true
        },
        {
          "name": "POPBILL_CORP_NUM",
          "description": "Member business number (10 digits)",
          "isRequired": true,
          "isSecret": false
        },
        {
          "name": "POPBILL_USER_ID",
          "description": "Popbill member user id",
          "isRequired": false,
          "isSecret": false
        },
        {
          "name": "POPBILL_TEST",
          "description": "true = test server (default true)",
          "isRequired": false,
          "isSecret": false
        },
        {
          "name": "OKAGENT_API_KEY",
          "description": "OK Agent key (free at okagent.kr) — writes then wait for your OK on KakaoTalk. Unset: writes ask for confirmation in the chat first.",
          "isRequired": false,
          "isSecret": true
        },
        {
          "name": "KMCP_WRITE_MODE",
          "description": "approval | confirm | direct (default: approval if OKAGENT_API_KEY is set, else confirm)",
          "isRequired": false,
          "isSecret": false
        }
      ]
    }
  ]
}
