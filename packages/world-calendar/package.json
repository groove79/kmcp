{
  "name": "@appmonster/mcp-world-calendar",
  "version": "0.1.0",
  "description": "MCP server for public holidays and business-day math in 200+ countries and regions: is it a working day, add N business days, count working days, local weekends (Fri–Sat etc.). No keys, offline.",
  "license": "MIT",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "mcp-world-calendar": "dist/cli.js"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "mcpName": "io.github.groove79/mcp-world-calendar",
  "keywords": ["mcp", "model-context-protocol", "holidays", "public-holidays", "business-days", "working-days", "calendar", "deadline", "weekend"],
  "repository": {
    "type": "git",
    "url": "https://github.com/groove79/kmcp",
    "directory": "packages/world-calendar"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && chmod +x dist/cli.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --test --import tsx test/*.test.ts",
    "start": "node dist/cli.js"
  },
  "dependencies": {
    "@appmonster/mcp-kr-biz-calendar": "workspace:*",
    "@modelcontextprotocol/sdk": "^1.12.0",
    "date-holidays": "^3.37.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3"
  },
  "engines": {
    "node": ">=20"
  }
}
