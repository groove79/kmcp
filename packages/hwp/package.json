{
  "name": "@appmonster/mcp-hwp",
  "version": "0.1.0",
  "description": "MCP server that converts HWP/HWPX (한글 문서) to Markdown and extracts tables, so AI agents can read Korean government and office documents.",
  "license": "MIT",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "mcp-hwp": "dist/cli.js"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "mcpName": "io.github.groove79/mcp-hwp",
  "keywords": [
    "mcp",
    "model-context-protocol",
    "hwp",
    "hwpx",
    "hangul",
    "korea",
    "한글",
    "문서변환",
    "markdown"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/groove79/kmcp",
    "directory": "packages/hwp"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && chmod +x dist/cli.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --test --import tsx test/*.test.ts",
    "start": "node dist/cli.js"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.0",
    "cfb": "^1.2.2",
    "fast-xml-parser": "^5.0.0",
    "fflate": "^0.8.2",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3"
  },
  "engines": {
    "node": ">=20"
  }
}
